<!-- app/views/whiskies/new.html.erb -->
<%= form_with model: @whisky, local: true, html: { multipart: true, class: "bg-gray-800 p-6 sm:p-8 rounded-lg shadow-lg space-y-6" } do |f| %>

  <!-- 1. 銘柄 -->
  <div>
    <%= f.label :whisky_name, "銘柄", class: "block text-lg font-semibold mb-2" %>
    <span class="text-red-500 ml-2">*</span>
    <%= f.text_field :whisky_name, class: "form-input-dark", placeholder: "例: ラフロイグ 10年", required: true %>

    <!-- ボトル写真 -->
    <%= f.label :whisky_photo, "ボトルの写真（任意）", class: "block text-sm font-medium text-gray-400 mt-4 mb-1" %>
    <%= f.file_field :whisky_photo, class: "form-file-dark", accept: "image/*" %>
  </div>

  <!-- 2. 飲み方 -->
  <div>
    <%= f.label :drink_style, "飲み方", class: "block text-lg font-semibold mb-2" %>
    <span class="text-red-500 ml-2">*</span>
    <%= f.select :drink_style, options_for_select([["ストレート", "straight"], ["オンザロック", "on_the_rock"], ["ハイボール", "highball"], ["水割り", "mizuwari"], ["お湯割り", "oyuwari"], ["その他", "other"]]), { prompt: "選択してください" }, class: "form-input-dark", required: true %>
  </div>

  <!-- 3. グラス -->
  <div>
    <%= f.label :glass_name, "グラス（任意）", class: "block text-lg font-semibold mb-2" %>
    <%= f.text_field :glass_name, class: "form-input-dark", placeholder: "例: グレンケアン" %>

    <!-- グラス写真 -->
    <%= f.label :glass_photo, "グラスの写真（任意）", class: "block text-sm font-medium text-gray-400 mt-4 mb-1" %>
    <%= f.file_field :glass_photo, class: "form-file-dark", accept: "image/*" %>
  </div>

  <!-- 3.5 グラスとの相性 -->
  <div>
    <%= f.label :glass_rating, "グラスとの相性（任意）", class: "block text-lg font-semibold mb-2" %>
    <div class="flex flex-wrap gap-x-6 gap-y-3 items-center mt-3">
      <% (1..5).each do |i| %>
        <label class="flex items-center cursor-pointer">
          <%= f.radio_button :glass_rating, i, class: "form-check-dark w-5 h-5 mr-2" %>
          <span><%= "★#{i}" %> <%= "(最高)" if i==5 %></span>
        </label>
      <% end %>
    </div>
  </div>

  <!-- 4. ピート -->
  <div>
    <%= f.label :peat, "ピート（スモーキーさ）", class: "block text-lg font-semibold mb-2" %>
    <div class="flex space-x-6 items-center mt-3">
      <label class="flex items-center cursor-pointer">
        <%= f.radio_button :peat, "yes", class: "form-check-dark w-5 h-5 mr-2" %>
        <span>有り</span>
      </label>
      <label class="flex items-center cursor-pointer">
        <%= f.radio_button :peat, "no", checked: true, class: "form-check-dark w-5 h-5 mr-2" %>
        <span>無し</span>
      </label>
    </div>
  </div>

  <!-- 5. 香り（複数選択可） -->
  <div>
    <%= f.label :aromas, "香り（複数選択可）", class: "block text-lg font-semibold mb-2" %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-3">
      <% ["sweet", "citrus", "cream", "flower", "wine", "iodine", "peat"].each do |aroma| %>
        <label class="flex items-center cursor-pointer bg-gray-700 p-3 rounded-lg hover:bg-gray-600 transition">
          <%= check_box_tag "whisky[aromas][]", aroma, @whisky.aromas&.include?(aroma), class: "form-check-dark w-5 h-5 mr-3" %>
          <span>
            <%=
              case aroma
              when "sweet" then "甘味 (バニラ, 蜂蜜)"
              when "citrus" then "柑橘 (レモン, オレンジ)"
              when "cream" then "クリーム (バター, ナッツ)"
              when "flower" then "花 (フローラル)"
              when "wine" then "ワイン (シェリー, 熟成感)"
              when "iodine" then "ヨード (薬品, 磯)"
              when "peat" then "ピート (スモーキー)"
              end
            %>
          </span>
        </label>
      <% end %>
    </div>
  </div>

  <!-- 6. 詳細 -->
  <div>
    <%= f.label :details, "詳細（テイスティングノート）", class: "block text-lg font-semibold mb-2" %>
    <%= f.text_area :details, rows: 6, class: "form-input-dark", placeholder: "例: 香りは強烈なピートとヨード香。味わいは薬品のような刺激とスモーキーさ。後味はスッキリ。" %>
  </div>

  <!-- 送信ボタン -->
  <div class="text-center pt-4">
    <%= f.submit "この内容で記録する", class: "bg-whisky-gold text-gray-900 font-bold py-3 px-10 rounded-lg text-lg hover:bg-yellow-600 transition duration-300 w-full sm:w-auto" %>
  </div>

<% end %>
