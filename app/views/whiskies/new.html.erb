<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whisky Log - 記録画面</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- フォント -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;600&display=swap');
        
        body {
            font-family: 'Inter', 'Noto Sans JP', sans-serif;
            background-color: #1a1a1a;
            color: #e0e0e0;
        }
        .font-serif {
            font-family: 'Noto Serif JP', serif;
        }
        .whisky-gold {
            color: #eab308;
        }
        .bg-whisky-gold {
            background-color: #eab308;
        }
        .border-whisky-gold {
            border-color: #eab308;
        }
        .form-input-dark {
            background-color: #374151;
            border: 1px solid #4b5563;
            color: #e0e0e0;
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
            width: 100%;
            transition: border-color 0.3s, box-shadow 0.3s;
        }
        .form-input-dark:focus {
            outline: none;
            border-color: #eab308;
            box-shadow: 0 0 0 2px #eab308;
        }
        .form-check-dark {
            accent-color: #eab308;
        }
        .form-file-dark {
            display: block;
            width: 100%;
            background-color: #374151;
            border: 1px solid #4b5563;
            border-radius: 0.5rem;
            color: #9ca3af;
            font-size: 0.875rem;
        }
        .form-file-dark::file-selector-button {
            background-color: #4b5563;
            border: none;
            color: #e0e0e0;
            padding: 0.75rem 1rem;
            margin-right: 1rem;
            cursor: pointer;
            font-weight: 600;
            transition: background-color 0.3s;
        }
        .form-file-dark::file-selector-button:hover {
            background-color: #5a6a80;
        }
    </style>
</head>
<body class="bg-gray-900 text-gray-200">

    <%# ヘッダー %>
    <%= render partial: "header" %>

    <!-- メインコンテンツ -->
    <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="max-w-3xl mx-auto">
            <h1 class="font-serif text-4xl font-bold mb-8 text-center">
                ウイスキーを記録する
            </h1>

  <%= form_with model: @whisky, local: true, html: { class: "bg-gray-800 p-6 sm:p-8 rounded-lg shadow-lg space-y-6", multipart: true } do |f| %>
      
 <%# デバッグ用 - インラインスタイル使用 %>
  <div style="background-color: #1e40af; color: white; padding: 16px; margin-bottom: 16px; border-radius: 8px;">
    <p style="margin: 4px 0;"><strong>デバッグ情報:</strong></p>
    <p style="margin: 4px 0;">drink_style: <%= @whisky.drink_style.inspect %></p>
    <p style="margin: 4px 0;">new_record?: <%= @whisky.new_record? %></p>
    <p style="margin: 4px 0;">errors: <%= @whisky.errors.full_messages.inspect %></p>
    <p style="margin: 4px 0;">aromas: <%= @whisky.aromas.inspect %></p>
  </div>

  <%# エラーメッセージ表示 %>
  <% if @whisky.errors.any? %>
    <div class="bg-red-900 border border-red-700 text-red-200 px-4 py-3 rounded">


  <%# エラーメッセージ表示 %>
  <% if @whisky.errors.any? %>
    <div class="bg-red-900 border border-red-700 text-red-200 px-4 py-3 rounded">
      <strong><%= pluralize(@whisky.errors.count, "error") %> prohibited this whisky from being saved:</strong>
      <ul class="list-disc list-inside mt-2">
        <% @whisky.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

      <%# 1. 銘柄 %>
      <div>
        <%= f.label :whisky_name, "銘柄", class: "block text-lg font-semibold mb-2" %>
        <span class="text-red-500 ml-2">*</span>
        <%= f.text_field :whisky_name, placeholder: "例: ラフロイグ 10年", class: "form-input-dark", required: true %>
        
        <%= f.label :whisky_photo, "ボトルの写真（任意）", class: "block text-sm font-medium text-gray-400 mt-4 mb-1" %>
        <%= f.file_field :whisky_photo, accept: "image/*", class: "form-file-dark" %>
      </div>


<%# 2. 飲み方 %>
<div>
  <%= f.label :drink_style, "飲み方", class: "block text-lg font-semibold mb-2" %>
  <span class="text-red-500 ml-2">*</span>
  <%= f.select :drink_style, 
      [
        ["ストレート", "straight"],
        ["オンザロック", "on_the_rock"],
        ["ハイボール", "highball"],
        ["水割り", "mizuwari"],
        ["お湯割り", "oyuwari"],
        ["その他", "other"]
      ],
      {},
      { class: "form-input-dark", required: true } 
  %>
</div>

      <%# 3. グラス %>
      <div>
        <%= f.label :glass_name, "グラス（任意）", class: "block text-lg font-semibold mb-2" %>
        <%= f.text_field :glass_name, placeholder: "例: グレンケアン", class: "form-input-dark" %>
        
        <%= f.label :glass_photo, "グラスの写真（任意）", class: "block text-sm font-medium text-gray-400 mt-4 mb-1" %>
        <%= f.file_field :glass_photo, accept: "image/*", class: "form-file-dark" %>
      </div>

      <%# 3.5 グラスとの相性 %>
      <div>
        <%= f.label :glass_rating, "グラスとの相性（任意）", class: "block text-lg font-semibold mb-2" %>
        <div class="flex flex-wrap gap-x-6 gap-y-3 items-center mt-3">
          <% (1..5).each do |rating| %>
            <label class="flex items-center cursor-pointer">
              <%= f.radio_button :glass_rating, rating, class: "form-check-dark w-5 h-5 mr-2" %>
              <span>★<%= rating %><%= rating == 5 ? " (最高)" : "" %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%# 4. ピート %>
      <div>
        <%= f.label :peat, "ピート（スモーキーさ）", class: "block text-lg font-semibold mb-2" %>
        <div class="flex space-x-6 items-center mt-3">
          <label class="flex items-center cursor-pointer">
            <%= f.radio_button :peat, true, class: "form-check-dark w-5 h-5 mr-2" %>
            <span>有り</span>
          </label>
          <label class="flex items-center cursor-pointer">
            <%= f.radio_button :peat, false, class: "form-check-dark w-5 h-5 mr-2", checked: true %>
            <span>無し</span>
          </label>
        </div>
      </div>

      <%# 5. 香り（複数選択可） %>
      <div>
        <%= f.label :aromas, "香り（複数選択可）", class: "block text-lg font-semibold mb-2" %>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-3">
          <% [
            ["甘味 (バニラ, 蜂蜜)", "sweet"],
            ["柑橘 (レモン, オレンジ)", "citrus"],
            ["クリーム (バター, ナッツ)", "cream"],
            ["花 (フローラル)", "flower"],
            ["ワイン (シェリー, 熟成感)", "wine"],
            ["ヨード (薬品, 磯)", "iodine"],
            ["ピート (スモーキー)", "peat"]
          ].each do |label, value| %>
            <label class="flex items-center cursor-pointer bg-gray-700 p-3 rounded-lg hover:bg-gray-600 transition">
              <%= check_box_tag "whisky[aromas][]", value, (@whisky.aromas || []).include?(value), class: "form-check-dark w-5 h-5 mr-3" %>
              <span><%= label %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%# 6. 詳細 %>
      <div>
        <%= f.label :details, "詳細（テイスティングノート）", class: "block text-lg font-semibold mb-2" %>
        <%= f.text_area :details, rows: 6, class: "form-input-dark", placeholder: "例: 香りは強烈なピートとヨード香。味わいは薬品のような刺激とスモーキーさ。後味はスッキリ。" %>
      </div>

      <%# 送信ボタン %>
      <div class="text-center pt-4">
        <%= f.submit "この内容で記録する", class: "bg-whisky-gold text-gray-900 font-bold py-3 px-10 rounded-lg text-lg hover:bg-yellow-600 transition duration-300 w-full sm:w-auto cursor-pointer" %>
      </div>

            <% end %>
        </div>
    </main>

    <!-- フッター -->
    <footer class="bg-black text-gray-400 py-8 mt-16">
        <div class="container mx-auto px-4 text-center">
            <p>&copy; 2025 Malt Log. All rights reserved.</p>
            <div class="flex justify-center space-x-4 mt-4">
                <%= link_to "利用規約", "#", class: "hover:text-white" %>
                <%= link_to "プライバシーポリシー", "#", class: "hover:text-white" %>
            </div>
        </div>
    </footer>

</body>
</html>