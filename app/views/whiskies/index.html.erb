<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whisky Log - UI Prototype (Dark)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <%= javascript_importmap_tags %>
    <!-- Interフォント -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        /* オーセンティックバーの雰囲気を出すために、
         Tailwindのデフォルト(Inter)に加えて、少し格調高いセリフ体（明朝体）も定義しておきます 
         例: h1, h2 などに 'font-serif' を適用する
        */
        @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;600&display=swap');
        
        body {
            font-family: 'Inter', 'Noto Sans JP', sans-serif;
            background-color: #1a1a1a; /* 非常に暗いグレー（ほぼ黒） */
            color: #e0e0e0; /* 明るすぎない白 */
        }
        .font-serif {
            font-family: 'Noto Serif JP', serif;
        }
        /* ウイスキーの琥珀色（アクセント） */
        .whisky-gold {
            color: #eab308; /* Tailwindの amber-500 */
        }
        .bg-whisky-gold {
            background-color: #eab308;
        }
        .border-whisky-gold {
            border-color: #eab308;
        }
    </style>
</head>
<body class="bg-gray-900 text-gray-200">

    <%# ヘッダー %>
    <%= render partial: "header" %>

    <!-- ===== メインコンテンツ ===== -->
    <main>
        
        <!-- 1. ヒーローセクション -->
        <section id="home" class="relative h-[60vh] md:h-[70vh] flex items-center justify-center text-center text-white overflow-hidden">
            <!-- 背景画像（プレースホルダー） -->
            <div class="absolute inset-0 bg-black">
                <img src="https://placehold.co/1600x900/333333/555555?text=Authentic+Bar+Image" alt="バーの背景画像" class="w-full h-full object-cover opacity-30">
            </div>
            <!-- コンテンツ -->
            <div class="relative z-10 p-4">
                <h1 class="font-serif text-4xl md:text-6xl font-bold mb-4">
                    あなただけの<span class="whisky-gold">最高の一杯</span>を。
                </h1>
                <p class="text-xl text-gray-300 mb-8">予算内で見つかる、あなた好みの一本と飲み方を記録・発見しよう。</p>
                
                <% if user_signed_in? %>
                  <%= link_to "試行ログを作成する", new_whisky_path, class: "bg-whisky-gold text-gray-900 font-bold py-3 px-8 rounded-lg text-lg hover:bg-yellow-600 transition duration-300" %>
                <% else %>
                  <%= link_to "今すぐ始める (無料)", new_user_registration_path, class: "bg-whisky-gold text-gray-900 font-bold py-3 px-8 rounded-lg text-lg hover:bg-yellow-600 transition duration-300" %>
                <% end %>
            </div>
        </section>


        <!-- 2. 機能紹介 / 導線 -->
        <section id="features" class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- 記録する -->
                <div class="bg-gray-800 p-8 rounded-lg shadow-lg text-center">
                  <%= link_to new_whisky_path, class: "block" do %>
                    <h2 class="font-serif text-3xl font-semibold mb-4 whisky-gold">記録する (Log)</h2>
                        <p class="text-gray-300 mb-6">飲んだウイスキー、飲み方、グラス、感想を記録。あなただけのデータベースを構築。</p>
                    <% end %>
                  <%= link_to "▶ ログ作成ページへ", new_whisky_path, class: "nav-user text-whisky-gold font-semibold hover:underline" %>
                  <p class="nav-guest text-gray-500">（ログイン後に利用可能です）</p>
            </div>
                <!-- 探す -->
                <div class="bg-gray-800 p-8 rounded-lg shadow-lg text-center">
                    <h2 class="font-serif text-3xl font-semibold mb-4 whisky-gold">探す (Discover)</h2>
                    <p class="text-gray-300 mb-6">予算や好みの味わいからウイスキーを検索。他の人のログも参考に。</p>
                    <%= link_to "▶ ウイスキー検索ページへ", search_whiskies_path, class: "text-whisky-gold font-semibold hover:underline" %>
                </div>
            </div>
        </section>
        
        <%# フッターの貼り付け %>
            <%= render partial: "footer" %>
