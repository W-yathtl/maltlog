    <!-- ===== ヘッダー ===== -->
<header class="bg-black bg-opacity-70 sticky top-0 z-50 backdrop-blur-sm">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
    <!-- ロゴ -->
    <%= link_to root_path, class: "text-2xl font-bold font-serif" do %>
      <span class="whisky-gold">M</span>alt <span class="whisky-gold">L</span>og
    <% end %>

    <!-- ナビゲーション（デスクトップ） -->
    <div class="hidden md:flex items-center space-x-6">
      <!-- 共通 -->
      <%= link_to "ウイスキーを探す", "#recommend", class: "hover:text-whisky-gold transition duration-300" %>

      <% if user_signed_in? %>
        <!-- ログイン時のみ表示 -->
        <%= link_to "ウイスキーを記録する", new_whisky_path, class: "nav-user bg-whisky-gold text-gray-900 font-semibold py-2 px-4 rounded-lg hover:bg-yellow-600 transition duration-300" %>
               <%= link_to current_user.nickname || current_user.email.split('@').first, user_path(current_user), class: "hover:text-whisky-gold transition duration-300" %>
              <li><%= link_to 'ログアウト', destroy_user_session_path, data: { turbo_method: :delete }, class: "hover:text-whisky-gold transition duration-300" %></li>
      <% else %>
        <!-- ログアウト時のみ表示 -->
        <%= link_to "新規登録", new_user_registration_path, class: "nav-guest hover:text-whisky-gold transition duration-300" %>
        <%= link_to "ログイン", new_user_session_path, class: "nav-guest bg-whisky-gold text-gray-900 font-semibold py-2 px-4 rounded-lg hover:bg-yellow-600 transition duration-300" %>
      <% end %>
    </div>

    <!-- モバイル用メニューボタン -->
    <div class="md:hidden">
      <button class="text-gray-200 focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>